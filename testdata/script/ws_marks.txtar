# tix ws mark / marks: per repo, where tidy was done
mkdir home/Documents/Obsidian/a/.obsidian
mkdir home/Documents/Obsidian/a/tickets/MAN-1
cp man-1.md home/Documents/Obsidian/a/tickets/MAN-1/MAN-1.md
expand gitconfig
exec git init -q -b main seed
exec git -C seed add -A
exec git -C seed commit -q -m init
exec git clone -q --bare seed remote/acme/billing.git
exec git clone -q git@github.com:acme/billing.git home/Projects/repo-a/github/acme/billing
exec tix ws add MAN-1 github-acme-billing --base main --desc marks
env R=home/Projects/work-a/MAN-1/github-acme-billing
env W=home/Projects/work-a/MAN-1/workspace.json

# nothing recorded: exit 3
! exec tix ws marks MAN-1
! stderr .
stdout '^github-acme-billing tidy none$'

# mark
exec tix ws mark MAN-1 tidy github-acme-billing
stdout '^tix ws: github-acme-billing: tidy marked at [0-9a-f]{7}$'
grep '"tidy": \{' $W
exec tix ws marks MAN-1
stdout '^github-acme-billing tidy ok$'

# marks are kept when tix ws add finds the worktree
exec tix ws add MAN-1 github-acme-billing --base main --desc marks
grep '"tidy": \{' $W
exec tix ws marks MAN-1

# a commit after the mark: stale
cp seed/README.md $R/one.txt
exec git -C $R add one.txt
exec git -C $R commit -q -m one
! exec tix ws marks MAN-1
stdout '^github-acme-billing tidy stale$'

# a rewrite with the same tree keeps the mark ok
exec tix ws mark MAN-1 tidy
exec git -C $R commit -q --amend -m 'one again'
exec tix ws marks MAN-1
stdout '^github-acme-billing tidy ok$'

# a dirty worktree is not marked
cp seed/README.md $R/dirty.txt
! exec tix ws mark MAN-1 tidy
stderr 'tix ws: warning: github-acme-billing: uncommitted changes, not marked'
stdout '^tix ws: marked 0 of 1 repo\(s\); NOT marked: github-acme-billing$'
! stdout 'marked at'
rm $R/dirty.txt

# errors
! exec tix ws mark MAN-1 other
stderr 'unknown kind .other.'
! exec tix ws mark MAN-1 docs
stderr 'unknown kind .docs.'
! exec tix ws mark MAN-1 tidy nope
stderr 'no repo .nope.'
! exec tix ws mark MAN-9 tidy
stderr 'MAN-9 has no workspace'

# a missing worktree counts as not ok
exec git -C home/Projects/repo-a/github/acme/billing worktree remove --force $WORK/$R
! exec tix ws marks MAN-1
stdout '^github-acme-billing tidy missing$'


# tix ws env: the workspace's Go caches as exports
exec tix ws env MAN-1
stdout '^export GOCACHE=..*MAN-1..cache.go.build.$'
stdout '^export GOMODCACHE=.'
stdout '^export GOPATH=.'
cd home/Projects/work-a/MAN-1
exec tix ws env
stdout '^export GOPATH=.'
cd $WORK
! exec tix ws env
stderr 'not in a ticket workspace'

-- man-1.md --
---
summary: First
status: in-progress
---
-- gitconfig --
[url "$WORK/remote/"]
	insteadOf = git@github.com:
-- seed/README.md --
# billing

